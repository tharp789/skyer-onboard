[Unit]
Description=Skyer Onboard Drone Container
Documentation=https://github.com/skyer-onboard
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/home/tyler/Documents/skyer-onboard
ExecStart=/usr/bin/docker compose up -d drone
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
